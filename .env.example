DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Optional override if the built frontend lives somewhere other than frontend/dist.
# DJANGO_FRONTEND_BUILD_DIR=frontend/dist
# Optional persistent-disk path for SQLite if you attach durable storage in production.
# DJANGO_SQLITE_PATH=/app/data/db.sqlite3
DJANGO_LOG_LEVEL=INFO
DATA_PROCESSING_LOG_LEVEL=INFO
WEB_CONCURRENCY=1
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=180
CSV_CHUNK_SIZE=500
STAGED_FILE_CACHE_MAX_ITEMS=2
STAGED_FILE_CACHE_TTL_SECONDS=900
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
# Set CELERY_TASK_ALWAYS_EAGER=True if you want async endpoints to execute inline during simple local debugging.
# CELERY_TASK_ALWAYS_EAGER=False
# Set STAGED_FILE_CACHE_MAX_ITEMS=0 to disable staged-file reuse between requests.
# Render injects PORT, RENDER_EXTERNAL_HOSTNAME, and RENDER_EXTERNAL_URL automatically.
PORT=8000
